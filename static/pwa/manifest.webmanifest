{
  "name": "Aegis Planner",
  "short_name": "Aegis",
  "description": "Aegis Planner — برنامه‌ریز شخصی رمزنگاری‌شده (زیرو-نالج)",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1017",
  "theme_color": "#16357f",
  "icons": [
    {
      "src": "/static/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "orientation": "any",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "categories": [
    "productivity",
    "lifestyle",
    "utilities"
  ],
  "prefer_related_applications": false
}
