# Copy to .env and fill in. NEVER commit the real .env.

# Generate a fresh key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# Keep False in production.
DJANGO_DEBUG=False

# Comma-separated. Add your PythonAnywhere host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourname.pythonanywhere.com

# Must include scheme. Needed for CSRF over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# v1.18 — Telegram handle shown on the public buy form (فاز H).
# PURCHASE_TELEGRAM=@yourhandle   # leave unset to hide the Telegram contact card

# Optional: Web Push (v1.11). Leave empty to disable push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# v3.2 — SEO launch switch. Default (unset/False) keeps the whole site
# noindex, exactly as before. Set to 1 ONLY when you're ready for the public
# landing to appear in search engines; app/panel/auth pages stay noindex.
# SEO_ALLOW_INDEX=1
